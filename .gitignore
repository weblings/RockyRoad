
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Dev debug channel output
.debug/

node_modules/
dist/
song-server.config.json

# Regenerated on every `npm run dev`/`npm run build` (compile-uikitml runs first in both
# scripts) - committed copies only ever get overwritten, never read as-is.
public/ui/*.json

# Written by the iwsdkDev Vite plugin on every dev-server start. Bakes in an absolute local
# filesystem path plus whatever port the server actually bound to (auto-increments if 8081
# is taken) - never portable to another checkout, and can churn from run to run on this one.
.mcp.json
.cursor/mcp.json
.vscode/mcp.json

# Local dev toggles (VITE_DEBUG, VITE_FAKE_SONGS), see Setup.md
.env.local
