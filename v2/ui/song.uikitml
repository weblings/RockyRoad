<style>
  /* Scale: 1 unit = 1cm, matching the panel's real 0.4m x 0.3m physical size
     (PanelUI's maxWidth/maxHeight in src/xr/index.ts) — same convention as
     ui/settings.uikitml. Derived from src/xr/screens/song.css +
     src/xr/panel.css's shared .frame/.button/.icon-btn/.actions classes
     (panel.css has no @import equivalent here, so those base rules are
     re-derived directly into this file, same as settings.uikitml did).

     Two structural simplifications vs. the original DOM, both purely
     cosmetic no-ops (same computed layout, fewer wrapper nodes):
     - .frame/.content/.actions in the original are three separately-clipped
       regions (content has top-only radius, actions has bottom-only radius)
       purely so .content could independently scroll — but this screen's
       content never scrolls, and both regions use the identical #0a0a0a
       background, so they're collapsed into one flat .panel here (matches
       settings.uikitml's .panel exactly: one background, one full-radius).
     - The .row/.text-wrap wrapper divs around the art box and artist name
       (present in the original song.css, likely Figma auto-layout residue)
       are flattened — .song-details lays out its children directly. */

  .panel {
    width: 40;
    height: 30;
    display: flex;
    flex-direction: column;
    background-color: #0a0a0a;
    border-radius: 1.2;
    font-family: inter;
    font-weight: medium;
    pointer-events: none;
  }

  .header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 1;
    gap-column: 1;
    padding-top: 1;
    padding-right: 1;
    padding-bottom: 0;
    padding-left: 1;
  }

  /* Shared by every icon+label button on this screen (header back button,
     both action-bar buttons) — matches panel.css's single global
     `.icon-btn > svg` / `.icon-btn > span` rule, which applies identically
     regardless of which button it's inside. */
  .icon {
    width: 1;
    height: 1;
    margin-left: -0.1;
  }
  .icon-label {
    position-type: relative;
    margin-left: 0.4;
    position-top: -0.05;
  }

  .back-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.2;
    gap-column: 0.2;
    padding: 0.8;
    border-radius: 0.5;
    font-size: 1.2;
    cursor: pointer;
  }

  /* Color variants — composed onto .back-btn/.action-btn via a second
     class, matching panel.css's own .button.primary-dark/.primary-light
     modifier pattern (Settings baked its one-off back button colors
     directly into .back-btn instead, since it only ever needed one
     variant; this screen needs both, so kept separate here). */
  .primary-dark {
    background-color: #333333;
    color: #ffffff;
  }
  .primary-dark:hover  { background-color: #515151; }
  .primary-dark:active { background-color: #7c7c7c; }

  .primary-light {
    background-color: #dadada;
    color: #111111;
  }
  .primary-light:hover  { background-color: #bebebe; }
  .primary-light:active { background-color: #9c9c9c; }

  .song-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .song-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap-row: 0.6;
    gap-column: 0.6;
  }

  .art-bg {
    width: 6.4;
    height: 6.4;
    flex-grow: 0;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #242424;
    border-radius: 1;
    overflow: hidden;
  }

  /* No separate "placeholder" element for missing album art — #ps-art-img
     just gets display:'none' set on it when there's no art URL, and
     .art-bg's own #242424 background shows through, matching the original
     (the "placeholder" there was really just the empty art-bg box; .art-
     image itself had no fallback styling of its own). One harmless,
     one-time "Image element missing src property" console.warn is expected
     on initial load, before the first _render() call either sets a real
     src or hides this element — no src is set in the static markup since
     it's always assigned at runtime. */
  .art-image {
    width: 6.4;
    height: 6.4;
    object-fit: cover;
  }

  .song-title {
    color: #ffffff;
    font-size: 2;
    font-weight: bold;
    text-align: center;
    line-height: 2;
  }

  /* font-weight 400/"normal" doesn't exist in uikit's prebuilt Inter set
     (light/medium/semi-bold/bold only) — medium is the closest available,
     same substitution UikitLessonsLearned.md already documents. */
  .artist-name {
    color: #8c8c8c;
    font-size: 1.4;
    font-weight: medium;
    text-align: center;
  }

  .actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 1;
    gap-column: 1;
    padding-top: 0;
    padding-right: 1;
    padding-bottom: 1;
    padding-left: 1;
  }

  .action-btn {
    width: 15;
    height: 3.6;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.2;
    gap-column: 0.2;
    padding: 0.8;
    border-radius: 0.5;
    font-size: 1.3;
    font-weight: medium;
    cursor: pointer;
  }

  /* Applied/removed at runtime on #ps-play when the song has no playable
     part — uikit has no native `disabled` attribute, so this stands in for
     it: pointer-events blocks clicks, opacity signals the state visually. */
  .disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>

<div class="panel">
  <div class="header">
    <button id="ps-back" class="back-btn primary-dark">
      <img src="/back-arrow.svg" class="icon" />
      <span class="icon-label">Library</span>
    </button>
  </div>

  <div class="song-info">
    <div class="song-details">
      <div class="art-bg">
        <img id="ps-art-img" class="art-image" />
      </div>
      <span id="ps-song-title" class="song-title">Song Title</span>
      <span id="ps-artist-name" class="artist-name">Artist Name</span>
    </div>
  </div>

  <div class="actions">
    <button id="ps-recal" class="action-btn primary-dark">
      <img src="/recal-icon.svg" class="icon" />
      <span class="icon-label">Reposition</span>
    </button>
    <button id="ps-play" class="action-btn primary-light">
      <img src="/play-icon.svg" class="icon" />
      <span class="icon-label">Play</span>
    </button>
  </div>
</div>
