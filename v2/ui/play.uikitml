<style>
  /* Scale: 1 unit = 1cm, matching the panel's real 0.4m x 0.3m physical size —
     same convention as settings.uikitml/song.uikitml. Derived from
     src/xr/screens/play.css + src/xr/panel.css's shared base classes
     (re-derived directly, no @import equivalent here, same as the other two
     migrated screens).

     Icon sizing note: the original markup uses different raw SVG pixel sizes
     per icon (library back-icon 10px, settings-gear/reposition 14px) but,
     matching the choice already made for song.uikitml, this file uses ONE
     uniform .icon size for every icon+label button on this screen — visual
     consistency across all icon buttons in the app is worth more than
     reproducing what look like somewhat arbitrary per-icon size choices in
     the original. The big circular play/pause button's own icon is
     intentionally a separate, larger .play-pause-icon class. */

  .panel {
    width: 40;
    height: 30;
    display: flex;
    flex-direction: column;
    background-color: #0a0a0a;
    border-radius: 1.2;
    font-family: inter;
    font-weight: medium;
    pointer-events: none;
  }

  /* Two-button nav row — overrides the single-back-button .header layout
     Settings/Song use. */
  .play-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-grow: 0;
    flex-shrink: 0;
    padding-top: 1;
    padding-right: 1;
    padding-bottom: 0;
    padding-left: 1;
  }

  .nav-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.4;
    gap-column: 0.4;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1;
    padding-right: 1;
    border-radius: 0.5;
    font-size: 1.2;
    cursor: pointer;
  }

  /* Shared by every icon+label button on this screen. */
  .icon {
    width: 1;
    height: 1;
    margin-left: -0.1;
  }
  .icon-label {
    position-type: relative;
    margin-left: 0.4;
    position-top: -0.05;
  }

  /* Note-streak/notes-total display — feature doesn't exist yet (no in-game
     note-hit tracking anywhere in the XR port, see NoteDetector/Stretch Goal
     B in the project plan). Markup+CSS built now per spec, gated fully
     hidden via STATS_ROW_ENABLED in XRActiveScene.ts until that lands. */
  .stats-row {
    display: none;
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
    gap-row: 0.6;
    gap-column: 0.6;
    flex-grow: 0;
    flex-shrink: 0;
  }
  .text-primary {
    color: #ffffff;
    font-size: 1.2;
    font-weight: bold;
  }
  .text-secondary {
    color: #c8c8c8;
    font-size: 1.0;
    font-weight: medium;
    margin-right: 0.6;
  }

  .primary-dark {
    background-color: #333333;
    color: #ffffff;
  }
  .primary-dark:hover  { background-color: #515151; }
  .primary-dark:active { background-color: #7c7c7c; }

  .play-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap-row: 1;
    gap-column: 1;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2.2;
    padding-right: 2.2;
  }

  .progress-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.8;
    gap-column: 0.8;
    padding-bottom: 1;
  }

  .progress-area {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    gap-row: 0.6;
    gap-column: 0.6;
  }

  .times {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .time-label {
    color: #c8c8c8;
    font-size: 1.1;
  }

  .seek-track {
    position-type: relative;
    width: 100%;
    height: 1.4;
    background-color: #333333;
    border-radius: 0.7;
    cursor: pointer;
  }
  .seek-track:hover  { background-color: #515151; }
  .seek-track:active { background-color: #7c7c7c; }

  .seek-fill {
    position-type: absolute;
    position-top: 0;
    position-left: 0;
    height: 100%;
    width: 0%;
    background-color: #c0c0c0;
    border-radius: 0.7;
  }

  /* transform-translate-x:-50% (a percentage of the thumb's own width, same
     semantics as CSS transform%) keeps the thumb centered on whatever
     position-left percentage XRActiveScene.ts sets each frame — the uikit
     equivalent of the original's `left:X%; transform:translateX(-50%)`
     centering trick, except only position-left needs a per-frame update;
     this half stays static. */
  .seek-thumb {
    position-type: absolute;
    position-top: -0.3;
    position-left: 0;
    transform-translate-x: -50%;
    width: 2;
    height: 2;
    background-color: #dadada;
    /* border-radius only accepts numeric/px values in uikit, not percentages
       (confirmed via the compiler's own warning) — half of width/height (2)
       gives a true circle instead of the original's border-radius:50%. */
    border-radius: 1;
    /* Missing from the initial port — the original had z-index:1 to render
       above the fill bar and section ticks. */
    z-index: 1;
  }
  .seek-thumb:hover  { background-color: #bebebe; }
  .seek-thumb:active { background-color: #9c9c9c; }

  /* Runtime-created per-section markers (see XRActiveScene.ts) — a Container
     constructed with this as its initial class, position-left set per
     instance since it varies by section. */
  .section-tick {
    position-type: absolute;
    position-top: 0;
    width: 0.2;
    height: 100%;
    background-color: #cccccc;
    opacity: 0.4;
  }

  .play-btn {
    width: 4;
    height: 4;
    flex-grow: 0;
    flex-shrink: 0;
    /* border-radius only accepts numeric/px values, not percentages — half
       of width/height (4) gives a true circle. */
    border-radius: 2;
    background-color: #eeeeee;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .play-btn:hover  { background-color: #bebebe; }
  .play-btn:active { background-color: #9c9c9c; }

  .play-pause-icon {
    width: 1;
    height: 1;
  }

  .song-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.8;
    gap-column: 0.8;
    padding-top: 0.8;
    padding-right: 0.8;
    padding-bottom: 0.8;
    padding-left: 0.8;
    background-color: #1a1a1a;
    border-radius: 0.6;
  }

  .art-thumb {
    width: 5.4;
    height: 5.4;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: #6e6e6e;
    border-radius: 0.4;
    overflow: hidden;
  }

  .art-image {
    width: 5.4;
    height: 5.4;
    object-fit: cover;
  }

  .song-meta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap-row: 0.2;
    gap-column: 0.2;
  }

  /* No native text-overflow:ellipsis in uikit — song title/artist are
     truncated with a manually-appended "…" in XRActiveScene.ts before being
     set here, so no wrapping/overflow handling is needed on these classes. */
  .song-title {
    color: #ffffff;
    font-size: 1.2;
    font-weight: bold;
  }
  .song-subtitle {
    color: #c8c8c8;
    font-size: 1.0;
    font-weight: medium;
  }

  /* Speed / Difficulty dropdown triggers — same trigger+popover shape as
     library.uikitml's .sort-dropdown/.sort-trigger/.sort-menu, hand-
     duplicated here since .uikitml has no @import/shared-stylesheet
     mechanism (each compiled panel is fully self-contained). If a third
     screen needs this component, re-derive it there the same way rather
     than trying to share the actual class rules. */
  .option-row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap-row: 0.8;
    gap-column: 0.8;
    flex-grow: 0;
    flex-shrink: 0;
  }

  /* Hugs its trigger's own content width rather than stretching to fill .option-row —
     a flex-grow:1 stretch here made a single trigger span the full row when Difficulty
     is hidden (song has no AvailableDifficulties). */
  .option-dropdown {
    position-type: relative;
    flex-grow: 0;
    flex-shrink: 0;
  }

  /* Difficulty's default state — XRActiveScene.ts flips this to 'flex' per song, only
     when that song's selected part actually has AvailableDifficulties. Compiled-in
     default so it stays hidden even before the first render sets it either way. */
  .option-dropdown-gated {
    display: none;
  }

  .option-trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap-row: 0.6;
    gap-column: 0.6;
    padding-top: 0.7;
    padding-right: 1;
    padding-bottom: 0.7;
    padding-left: 1;
    /* Explicit fixed width, not min-width — see the wrapping-mechanism
       explanation on .option-label below for why min-width didn't help.
       18 (tried previously) was a blind guess and rendered cartoonishly
       wide — 15 is calibrated against .action-btn below instead, an
       already-working reference at this same panel scale: it's width:15
       and comfortably fits "Reposition" (10 chars) plus an icon, and
       "Speed: 200%" is only one character longer with a smaller chevron
       than that icon. */
    width: 15;
    background-color: #333333;
    border-width: 0.1;
    border-color: #444444;
    border-radius: 0.6;
    cursor: pointer;
  }
  .option-trigger:hover  { background-color: #444444; }
  .option-trigger:active { background-color: #515151; }

  /* No whiteSpace override — despite the CSS-like naming, whiteSpace only
     controls whitespace collapsing in this library (see the width comment
     on .option-trigger), not line-wrapping; there's no property-level way
     to suppress wrapping, only a wide-enough container. */
  /* Applied to a UIKit.Text node OptionDropdown.setTriggerLabel() destroys and recreates on
     every value change (into an otherwise-empty slot div), rather than a static <span> mutated
     via setProperties({text}) — confirmed in-headset that mutating in place left stale/misaligned
     glyphs rendering behind new text. Both Speed's and Difficulty's trigger labels use this. */
  .option-label {
    color: #c8c8c8;
    font-size: 1.2;
  }

  /* Two stacked chevron images, display-toggled by menu-open state — same
     swap pattern as library.uikitml's #sort-chevron-down/#sort-chevron-up
     (a rotated-triangle glyph has no clean ASCII fallback, unlike '-'/'x'
     elsewhere in this app). */
  .option-chevron {
    width: 0.9;
    height: 0.9;
  }

  /* position-top is a literal estimate of the trigger's own rendered height
     plus a small gap (no calc() support) — tune once visible in-headset,
     same caveat as library.uikitml's .sort-menu.

     Deliberately NOT overflow:scroll. @pmndrs/uikit's scroll container sets
     pointer capture on whichever object was actually hit (node_modules/
     @pmndrs/uikit/dist/scroll.js) but releases it against the container
     specifically — a mismatch whenever a drag starts on a child button
     rather than empty container space, which wedges capture and
     permanently breaks scroll. At this popover's small size the buttons
     cover nearly the whole surface, so that's nearly every gesture
     (confirmed in-headset). Fixed height + overflow:hidden here is purely a
     clipping viewport now — XRActiveScene.ts's _wireOptionMenuScroll drives
     .option-menu-inner's position-top directly instead, the same custom-
     pointer-math approach already proven on the seek bar
     (_wireSeekDrag) rather than trusting uikit's scroll+click composition
     again. See UikitLessonsLearned.md. */
  .option-menu {
    position-type: absolute;
    position-top: 3.4;
    position-left: 0;
    z-index: 2;
    /* Explicit own value, not inherited — XRActiveScene.ts's
       _wireOptionMenuScroll temporarily sets the whole panel root's
       pointer-events to 'none' while a real drag is in progress (see the
       "disable other interactors" note in that function), so this menu
       needs its own override to stay hittable through that; pointer-events
       is an inherited property (node_modules/@pmndrs/uikit/dist/
       properties/inheritance.js), and a descendant's own explicit value
       always wins over whatever an ancestor resolves to. */
    pointer-events: auto;
    /* z-index alone only controls uikit's painter's-algorithm draw order
       (transparency/blend sorting) — it doesn't move the mesh, so this
       popover was still geometrically coplanar with the .actions bar behind
       it and GPU depth-tested/z-fought against the Reposition button's SVG,
       which also made it flaky to raycast. transform-translate-z (same
       property family as the seek-thumb's transform-translate-x) actually
       offsets it forward in 3D space instead. */
    transform-translate-z: 0.15;
    display: none;
    flex-direction: column;
    height: 8;
    overflow: hidden;
    background-color: #1a1a1a;
    border-width: 0.1;
    border-color: #333333;
    border-radius: 0.6;
    /* Explicit, matching .option-trigger's own width literally rather than
       min-width:100% (relative to .option-dropdown, the nearest
       position-type:relative ancestor) — no evidence this was actually
       causing a feedback loop (Yoga's absolute-position exclusion from a
       parent's hug-sizing happens inside the engine itself, not in the JS
       layer this codebase can inspect), but a relative tie back to a
       hugging ancestor was avoidable risk for zero benefit once this has
       its own fixed number anyway. */
    width: 15;
    padding-top: 0.4;
    padding-right: 0.4;
    padding-bottom: 0.4;
    padding-left: 0.4;
  }

  /* The actual scrollable content — a plain flex column XRActiveScene.ts
     translates via position-top. position-type:relative (not the default
     static) is required for that position-top to apply at all. */
  .option-menu-inner {
    position-type: relative;
    position-top: 0;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap-row: 0.3;
  }

  .option-item {
    flex-shrink: 0;
    padding-top: 0.5;
    padding-right: 1;
    padding-bottom: 0.5;
    padding-left: 1;
    color: #c8c8c8;
    font-size: 1.2;
    cursor: pointer;
  }
  .option-item:hover  { background-color: #2a2a2a; color: #ffffff; }
  .option-item:active { background-color: #515151; color: #ffffff; }
  .option-item-selected { background-color: #242424; color: #ffffff; }

  .actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 1;
    gap-column: 1;
    padding-top: 0;
    padding-right: 1;
    padding-bottom: 1;
    padding-left: 1;
  }

  .action-btn {
    width: 15;
    height: 3.6;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.2;
    gap-column: 0.2;
    padding-top: 0.8;
    padding-right: 0.8;
    padding-bottom: 0.8;
    padding-left: 0.8;
    border-radius: 0.5;
    font-size: 1.3;
    font-weight: medium;
    cursor: pointer;
  }
</style>

<div class="panel">
  <div class="play-header">
    <button id="as-library" class="nav-btn primary-dark">
      <img src="/back-arrow.svg" class="icon" />
      <span class="icon-label">Library</span>
    </button>
    <div id="as-stats-row" class="stats-row">
      <span id="as-streak-count" class="text-primary">0</span>
      <span class="text-secondary">Note Streak</span>
      <span id="as-notes-progress" class="text-primary">0/0</span>
      <span class="text-secondary">Total</span>
    </div>
    <button id="as-settings" class="nav-btn primary-dark">
      <img src="/settings-gear-icon.svg" class="icon" />
      <span class="icon-label">Settings</span>
    </button>
  </div>

  <div class="play-body">
    <div class="progress-row">
      <div class="progress-area">
        <div class="times">
          <span id="as-time" class="time-label">0:00</span>
          <span id="as-time-total" class="time-label">0:00</span>
        </div>
        <div id="as-seek-track" class="seek-track">
          <div id="as-seek-fill" class="seek-fill"></div>
          <div id="as-seek-thumb" class="seek-thumb"></div>
        </div>
      </div>
      <button id="as-playpause" class="play-btn">
        <img id="as-play-icon" class="play-pause-icon" src="/play-icon.svg" />
        <img id="as-pause-icon" class="play-pause-icon" src="/pause-icon.svg" />
      </button>
    </div>

    <div class="song-row">
      <div class="art-thumb">
        <img id="as-art-img" class="art-image" />
      </div>
      <div class="song-meta">
        <span id="as-song-title" class="song-title">Song Title</span>
        <span id="as-song-subtitle" class="song-subtitle">Artist Name</span>
      </div>
    </div>

    <div class="option-row">
      <div class="option-dropdown">
        <button id="as-speed-trigger" class="option-trigger">
          <div id="as-speed-trigger-label-slot"></div>
          <img id="as-speed-chevron-down" class="option-chevron" src="/chevron-down.svg" />
          <img id="as-speed-chevron-up" class="option-chevron" src="/chevron-up.svg" />
        </button>
        <div id="as-speed-menu" class="option-menu">
          <div id="as-speed-menu-inner" class="option-menu-inner">
            <button id="as-speed-opt-20" class="option-item">20%</button>
            <button id="as-speed-opt-40" class="option-item">40%</button>
            <button id="as-speed-opt-60" class="option-item">60%</button>
            <button id="as-speed-opt-80" class="option-item">80%</button>
            <button id="as-speed-opt-100" class="option-item">100%</button>
            <button id="as-speed-opt-120" class="option-item">120%</button>
            <button id="as-speed-opt-140" class="option-item">140%</button>
            <button id="as-speed-opt-160" class="option-item">160%</button>
            <button id="as-speed-opt-180" class="option-item">180%</button>
            <button id="as-speed-opt-200" class="option-item">200%</button>
          </div>
        </div>
      </div>
      <div id="as-difficulty-dropdown" class="option-dropdown option-dropdown-gated">
        <button id="as-difficulty-trigger" class="option-trigger">
          <div id="as-difficulty-trigger-label-slot"></div>
          <img id="as-difficulty-chevron-down" class="option-chevron" src="/chevron-down.svg" />
          <img id="as-difficulty-chevron-up" class="option-chevron" src="/chevron-up.svg" />
        </button>
        <div id="as-difficulty-menu" class="option-menu">
          <div id="as-difficulty-menu-inner" class="option-menu-inner"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="actions">
    <button id="as-reposition" class="action-btn primary-dark">
      <img src="/recal-icon.svg" class="icon" />
      <span class="icon-label">Reposition</span>
    </button>
  </div>
</div>
