<style>
  /* Scale: 1 unit = 1cm, matching the panel's real 0.4m x 0.3m physical size —
     same convention as settings.uikitml/song.uikitml. Derived from
     src/xr/screens/play.css + src/xr/panel.css's shared base classes
     (re-derived directly, no @import equivalent here, same as the other two
     migrated screens).

     Icon sizing note: the original markup uses different raw SVG pixel sizes
     per icon (library back-icon 10px, settings-gear/reposition 14px) but,
     matching the choice already made for song.uikitml, this file uses ONE
     uniform .icon size for every icon+label button on this screen — visual
     consistency across all icon buttons in the app is worth more than
     reproducing what look like somewhat arbitrary per-icon size choices in
     the original. The big circular play/pause button's own icon is
     intentionally a separate, larger .play-pause-icon class. */

  .panel {
    width: 40;
    height: 30;
    display: flex;
    flex-direction: column;
    background-color: #0a0a0a;
    border-radius: 1.2;
    font-family: inter;
    font-weight: medium;
    pointer-events: none;
  }

  /* Two-button nav row — overrides the single-back-button .header layout
     Settings/Song use. */
  .play-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-grow: 0;
    flex-shrink: 0;
    padding-top: 1;
    padding-right: 1;
    padding-bottom: 0;
    padding-left: 1;
  }

  .nav-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.4;
    gap-column: 0.4;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1;
    padding-right: 1;
    border-radius: 0.5;
    font-size: 1.2;
    cursor: pointer;
  }

  /* Shared by every icon+label button on this screen. */
  .icon {
    width: 1;
    height: 1;
    margin-left: -0.1;
  }
  .icon-label {
    position-type: relative;
    margin-left: 0.4;
    position-top: -0.05;
  }

  .primary-dark {
    background-color: #333333;
    color: #ffffff;
  }
  .primary-dark:hover  { background-color: #515151; }
  .primary-dark:active { background-color: #7c7c7c; }

  .play-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap-row: 0.8;
    gap-column: 0.8;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2.2;
    padding-right: 2.2;
  }

  .progress-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.8;
    gap-column: 0.8;
  }

  .progress-area {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    gap-row: 0.6;
    gap-column: 0.6;
  }

  .times {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .time-label {
    color: #c8c8c8;
    font-size: 1.1;
  }

  .seek-track {
    position-type: relative;
    width: 100%;
    height: 1.4;
    background-color: #333333;
    border-radius: 0.7;
    cursor: pointer;
  }
  .seek-track:hover  { background-color: #515151; }
  .seek-track:active { background-color: #7c7c7c; }

  .seek-fill {
    position-type: absolute;
    position-top: 0;
    position-left: 0;
    height: 100%;
    width: 0%;
    background-color: #c0c0c0;
    border-radius: 0.7;
  }

  /* transform-translate-x:-50% (a percentage of the thumb's own width, same
     semantics as CSS transform%) keeps the thumb centered on whatever
     position-left percentage XRActiveScene.ts sets each frame — the uikit
     equivalent of the original's `left:X%; transform:translateX(-50%)`
     centering trick, except only position-left needs a per-frame update;
     this half stays static. */
  .seek-thumb {
    position-type: absolute;
    position-top: -0.3;
    position-left: 0;
    transform-translate-x: -50%;
    width: 2;
    height: 2;
    background-color: #dadada;
    /* border-radius only accepts numeric/px values in uikit, not percentages
       (confirmed via the compiler's own warning) — half of width/height (2)
       gives a true circle instead of the original's border-radius:50%. */
    border-radius: 1;
    /* Missing from the initial port — the original had z-index:1 to render
       above the fill bar and section ticks. */
    z-index: 1;
  }
  .seek-thumb:hover  { background-color: #bebebe; }
  .seek-thumb:active { background-color: #9c9c9c; }

  /* Runtime-created per-section markers (see XRActiveScene.ts) — a Container
     constructed with this as its initial class, position-left set per
     instance since it varies by section. */
  .section-tick {
    position-type: absolute;
    position-top: 0;
    width: 0.2;
    height: 100%;
    background-color: #cccccc;
    opacity: 0.4;
  }

  .play-btn {
    width: 4;
    height: 4;
    flex-grow: 0;
    flex-shrink: 0;
    /* border-radius only accepts numeric/px values, not percentages — half
       of width/height (4) gives a true circle. */
    border-radius: 2;
    background-color: #eeeeee;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .play-btn:hover  { background-color: #bebebe; }
  .play-btn:active { background-color: #9c9c9c; }

  .play-pause-icon {
    width: 1.9;
    height: 1.9;
  }

  .song-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.8;
    gap-column: 0.8;
    padding-top: 0.4;
    padding-bottom: 0.4;
  }

  .art-thumb {
    width: 5.4;
    height: 5.4;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: #6e6e6e;
    border-radius: 0.4;
    overflow: hidden;
  }

  .art-image {
    width: 5.4;
    height: 5.4;
    object-fit: cover;
  }

  .song-meta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap-row: 0.2;
    gap-column: 0.2;
  }

  /* No native text-overflow:ellipsis in uikit — song title/artist are
     truncated with a manually-appended "…" in XRActiveScene.ts before being
     set here, so no wrapping/overflow handling is needed on these classes. */
  .song-title {
    color: #ffffff;
    font-size: 1.2;
    font-weight: bold;
  }
  .song-subtitle {
    color: #c8c8c8;
    font-size: 1.0;
    font-weight: medium;
  }

  .speed-control {
    flex-grow: 0;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap-row: 0.4;
    gap-column: 0.4;
  }

  .speed-label {
    color: #e8e8e8;
    font-size: 1.2;
    font-weight: bold;
  }

  .speed-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap-row: 0.4;
    gap-column: 0.4;
  }

  /* Reuses settings.uikitml's .stepper-btn/.stepper-val treatment (light-
     button color family) rather than the original's secondary-dark speed
     button colors, per the same explicit style choice already made there. */
  .speed-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #dadada;
    color: #111111;
    font-weight: bold;
    width: 2.2;
    height: 2.2;
    border-radius: 0.4;
    font-size: 1.1;
    cursor: pointer;
  }
  .speed-btn:hover  { background-color: #bebebe; }
  .speed-btn:active { background-color: #9c9c9c; }

  .speed-value {
    color: #e8e8e8;
    font-size: 1.2;
    font-weight: bold;
    min-width: 3.8;
    text-align: center;
  }

  .actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 1;
    gap-column: 1;
    padding-top: 0;
    padding-right: 1;
    padding-bottom: 1;
    padding-left: 1;
  }

  .action-btn {
    width: 15;
    height: 3.6;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    gap-row: 0.2;
    gap-column: 0.2;
    padding: 0.8;
    border-radius: 0.5;
    font-size: 1.3;
    font-weight: medium;
    cursor: pointer;
  }
</style>

<div class="panel">
  <div class="play-header">
    <button id="as-library" class="nav-btn primary-dark">
      <img src="/back-arrow.svg" class="icon" />
      <span class="icon-label">Library</span>
    </button>
    <button id="as-settings" class="nav-btn primary-dark">
      <img src="/settings-gear-icon.svg" class="icon" />
      <span class="icon-label">Settings</span>
    </button>
  </div>

  <div class="play-body">
    <div class="progress-row">
      <div class="progress-area">
        <div class="times">
          <span id="as-time" class="time-label">0:00</span>
          <span id="as-time-total" class="time-label">0:00</span>
        </div>
        <div id="as-seek-track" class="seek-track">
          <div id="as-seek-fill" class="seek-fill"></div>
          <div id="as-seek-thumb" class="seek-thumb"></div>
        </div>
      </div>
      <button id="as-playpause" class="play-btn">
        <img id="as-play-icon" class="play-pause-icon" src="/play-icon.svg" />
        <img id="as-pause-icon" class="play-pause-icon" src="/pause-icon.svg" />
      </button>
    </div>

    <div class="song-row">
      <div class="art-thumb">
        <img id="as-art-img" class="art-image" />
      </div>
      <div class="song-meta">
        <span id="as-song-title" class="song-title">Song Title</span>
        <span id="as-song-subtitle" class="song-subtitle">Artist Name</span>
      </div>
      <div class="speed-control">
        <span class="speed-label">Speed</span>
        <div class="speed-row">
          <button id="as-speed-dec" class="speed-btn">-</button>
          <span id="as-speed-val" class="speed-value">1x</span>
          <button id="as-speed-inc" class="speed-btn">+</button>
        </div>
      </div>
    </div>
  </div>

  <div class="actions">
    <button id="as-reposition" class="action-btn primary-dark">
      <img src="/recal-icon.svg" class="icon" />
      <span class="icon-label">Reposition</span>
    </button>
  </div>
</div>
