{
  "name": "Rocky Road",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run bake && concurrently -n vite,songs -c blue,green \"vite\" \"npm:serve-songs\"",
    "dev:device": "npm run bake && concurrently -n vite,songs -c blue,green \"vite --mode device\" \"npm:serve-songs\"",
    "dev:demo": "cross-env VITE_DEMO_MODE=true npm run dev",
    "build": "npm run bake && tsc && vite build",
    "build:demo": "cross-env VITE_DEMO_MODE=true npm run build",
    "preview": "vite preview",
    "bake": "tsx tools/bake-songs.ts",
    "serve-songs": "tsx tools/song-server.ts"
  },
  "dependencies": {
    "@iwsdk/core": "0.3.1",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "html2canvas": "^1.4.1",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@felixtz/iwsdk-rag-mcp": "^0.3.1",
    "@iwsdk/vite-plugin-dev": "0.3.1",
    "@iwsdk/vite-plugin-uikitml": "0.3.1",
    "@meta-quest/hzdb": "^1.0.0",
    "@types/three": "*",
    "@types/wicg-file-system-access": "^2023.10.7",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
